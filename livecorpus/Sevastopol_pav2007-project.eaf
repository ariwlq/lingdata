    <TIER ANNOTATOR="@aas2007f" LINGUISTIC_TYPE_REF="utterance"
        PARTICIPANT="@aas2007f" TIER_ID="text@aas2007f">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1764"
                TIME_SLOT_REF1="ts1" TIME_SLOT_REF2="ts4">
                <ANNOTATION_VALUE>можешь примерно описать</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1765"
                TIME_SLOT_REF1="ts5" TIME_SLOT_REF2="ts15">
                <ANNOTATION_VALUE>ааа как проходили вообще твои дни вот в то время</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1766"
                TIME_SLOT_REF1="ts16" TIME_SLOT_REF2="ts21">
                <ANNOTATION_VALUE>то есть с утра начиная</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1767"
                TIME_SLOT_REF1="ts22" TIME_SLOT_REF2="ts26">
                <ANNOTATION_VALUE>примерно чем ты занималась</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1768"
                TIME_SLOT_REF1="ts27" TIME_SLOT_REF2="ts30">
                <ANNOTATION_VALUE>и до вечера</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1769"
                TIME_SLOT_REF1="ts32" TIME_SLOT_REF2="ts37">
                <ANNOTATION_VALUE>по будням / например</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3024"
                TIME_SLOT_REF1="ts314" TIME_SLOT_REF2="ts315">
                <ANNOTATION_VALUE>угу</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1770"
                TIME_SLOT_REF1="ts319" TIME_SLOT_REF2="ts320">
                <ANNOTATION_VALUE>угу</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1771"
                TIME_SLOT_REF1="ts321" TIME_SLOT_REF2="ts325">
                <ANNOTATION_VALUE>так / давай тогда</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1772"
                TIME_SLOT_REF1="ts326" TIME_SLOT_REF2="ts328">
                <ANNOTATION_VALUE>я думаю</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1773"
                TIME_SLOT_REF1="ts329" TIME_SLOT_REF2="ts337">
                <ANNOTATION_VALUE>я в любом случае подключаюсь в диалог</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1774"
                TIME_SLOT_REF1="ts339" TIME_SLOT_REF2="ts342">
                <ANNOTATION_VALUE>поэтому будем так</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1776"
                TIME_SLOT_REF1="ts343" TIME_SLOT_REF2="ts353">
                <ANNOTATION_VALUE>ааа расскажи кем ты хотела встать в детстве</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1777"
                TIME_SLOT_REF1="ts354" TIME_SLOT_REF2="ts359">
                <ANNOTATION_VALUE>прям ваще все что вспомнишь</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1778"
                TIME_SLOT_REF1="ts360" TIME_SLOT_REF2="ts371">
                <ANNOTATION_VALUE>с самого маленького возраста и до / сегодняшнего момента</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1779"
                TIME_SLOT_REF1="ts372" TIME_SLOT_REF2="ts379">
                <ANNOTATION_VALUE>какие у тебя щас планы на будущее</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1780"
                TIME_SLOT_REF1="ts380" TIME_SLOT_REF2="ts383">
                <ANNOTATION_VALUE>может быть мысли</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
